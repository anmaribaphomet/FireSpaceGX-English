# Copy this file as .env (in the same folder as app.py)
# and replace the value of OPENROUTER_API_KEY with your own key.
# Never upload the .env file to GitHub.
# (The Spanish names MODELO_IA, CLASIFICAR_CON_IA and RAZONAMIENTO_IA are also accepted.)

OPENROUTER_API_KEY=your-openrouter-key
AI_MODEL=nvidia/nemotron-3.5-super-vl:free
CLASSIFY_WITH_AI=no
AI_REASONING=none
